scalar Date

directive @auth on FIELD_DEFINITION

type User {
  id: ID!
  firebaseUid: String!
  appleId: String
  email: String
  name: String
  createdAt: String!
  updatedAt: String!
}

input UpdateUserProfileInput {
  name: String
}

enum AuthErrorCode {
  UNAUTHORIZED
  INVALID_TOKEN
  TOKEN_EXPIRED
  USER_NOT_FOUND
  RATE_LIMIT_EXCEEDED
}

type AuthError {
  message: String!
  code: AuthErrorCode!
  path: [String!]
}

type Fraction {
  numerator: Int!
  denominator: Int!
}

type Location {
  id: ID!
  name: String!
}

type PurchaseUnit {
  id: ID!
  name: String!
  ingredient: Ingredient!
}

type Category {
  id: ID!
  name: String!
  colorCode: String!
  ingredients: [Ingredient!]!
}

type Ingredient {
  id: ID!
  name: String!
  category: Category!
  inventory: [Inventory!]!
  purchaseHistory: [PurchaseHistory!]!
  purchaseUnits: [PurchaseUnit!]!
}

enum InventoryStatus {
  ACTIVE
  DISCARDED
  CONSUMED
}

type Inventory {
  id: ID!
  ingredient: Ingredient!
  quantity: Fraction!
  unit: String!
  expiryDate: String!
  frozen: Boolean!
  expired: Boolean!
  status: InventoryStatus!
}

type PurchaseHistory {
  id: ID!
  ingredient: Ingredient!
  date: String!
  location: Location!
  purchaseUnit: PurchaseUnit!
  price: Int!
}


input FractionInput {
  numerator: Int!
  denominator: Int!
}

input UpdateCategoryInput {
  name: String!
  colorCode: String
}

input NewLocation {
  name: String!
}

input UpdateLocationInput {
  name: String!
}

input NewPurchaseUnit {
  ingredientId: ID!
  name: String!
}

input UpdatePurchaseUnitInput {
  name: String!
}

input NewCategory {
  name: String!
  colorCode: String
}

input NewIngredient {
  name: String!
  categoryId: ID!
}

input NewInventory {
  ingredientId: ID!
  quantity: FractionInput!
  unit: String!
  expiryDate: String!
  frozen: Boolean!
}

input UpdateInventory {
  quantity: FractionInput
  unit: String
  expiryDate: String
  frozen: Boolean
}

input InventoryFilter {
  ingredientId: ID
  status: [InventoryStatus!]
}

enum InventorySort {
  EXPIRY_ASC
  EXPIRY_DESC
}

input NewPurchaseHistory {
  ingredientId: ID!
  date: String!
  locationId: ID!
  purchaseUnitId: ID!
  price: Int!
}

input UpdatePurchaseHistory {
  date: String
  locationId: ID
  purchaseUnitId: ID
  price: Int
}

input UpdateQuantity {
  numerator: Int!
  denominator: Int!
}

type Query {
  me: User @auth
  locations: [Location!]! @auth
  location(id: ID!): Location @auth
  purchaseUnits: [PurchaseUnit!]! @auth
  purchaseUnit(id: ID!): PurchaseUnit @auth
  purchaseUnitsByIngredient(ingredientId: ID!): [PurchaseUnit!]! @auth
  categories: [Category!]! @auth
  category(id: ID!): Category @auth
  ingredients(categoryId: ID, q: String): [Ingredient!]! @auth
  inventory(id: ID, filter: InventoryFilter, sort: InventorySort): [Inventory!]! @auth
  purchaseHistory(ingredientId: ID): [PurchaseHistory!]! @auth
}

type Mutation {
  updateUserProfile(input: UpdateUserProfileInput!): User! @auth
  createLocation(input: NewLocation!): Location! @auth
  updateLocation(id: ID!, input: UpdateLocationInput!): Location! @auth
  deleteLocation(id: ID!): Boolean! @auth
  createPurchaseUnit(input: NewPurchaseUnit!): PurchaseUnit! @auth
  updatePurchaseUnit(id: ID!, input: UpdatePurchaseUnitInput!): PurchaseUnit! @auth
  deletePurchaseUnit(id: ID!): Boolean! @auth
  createCategory(input: NewCategory!): Category! @auth
  updateCategory(id: ID!, input: UpdateCategoryInput!): Category! @auth
  deleteCategory(id: ID!): Boolean! @auth
  addIngredient(input: NewIngredient!): Ingredient! @auth
  deleteIngredient(id: ID!): Boolean! @auth
  addInventory(input: NewInventory!): Inventory! @auth
  updateInventory(id: ID!, input: UpdateInventory!): Inventory! @auth
  freezeInventory(id: ID!): Inventory! @auth
  deleteInventory(id: ID!): Boolean! @auth
  updateQuantity(id: ID!, input: UpdateQuantity!): Inventory! @auth
  discardInventory(id: ID!): Inventory! @auth
  consumeInventory(id: ID!): Inventory! @auth
  addPurchaseHistory(input: NewPurchaseHistory!): PurchaseHistory! @auth
  updatePurchaseHistory(id: ID!, input: UpdatePurchaseHistory!): PurchaseHistory! @auth
  deletePurchaseHistory(id: ID!): Boolean! @auth
}
